# Senha da área administrativa (OBRIGATÓRIO trocar em produção)
ADMIN_PASSWORD=troque-esta-senha
# Chave usada para assinar o cookie de sessão (use um valor longo e aleatório)
SECRET_KEY=troque-esta-chave
# true quando servido por HTTPS
COOKIE_SECURE=false
# Caminho do banco SQLite
DB_PATH=./backend/data/frota.db
# E-mail (opcional; sem SMTP_HOST as mensagens só aparecem no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=frota@sre.local
SMTP_TLS=true
